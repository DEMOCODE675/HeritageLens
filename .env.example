# ==============================================================================
# Tourist Guide SIH Twix - Environment Configuration
# ==============================================================================

# Existing Tourist Guide APIs (Optional)
REACT_APP_FOURSQUARE_API_KEY=
REACT_APP_ENABLE_FOURSQUARE_API=false
REACT_APP_GEOAPIFY_API_KEY=
REACT_APP_TRAVEL_ADVISOR_API_KEY=

# ------------------------------------------------------------------------------
# Firebase Configuration (Authentication & Firestore Database for Marketplace)
# Add your Firebase Web App credentials from Firebase Console -> Project Settings
# ------------------------------------------------------------------------------
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# ------------------------------------------------------------------------------
# Appwrite Configuration (Cloud Storage for Product Images & Videos)
# Add your Appwrite Cloud details from https://cloud.appwrite.io
# ------------------------------------------------------------------------------
REACT_APP_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
REACT_APP_APPWRITE_PROJECT_ID=
REACT_APP_APPWRITE_BUCKET_ID=
